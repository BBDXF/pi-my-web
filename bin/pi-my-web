#!/usr/bin/env node
// Standalone pi-my-web daemon. Env: PI_MY_WEB_PORT (3847), PI_MY_WEB_HOST (127.0.0.1), PI_MY_WEB_PASSWORD.
// Flags: --port N, --host H. Resolves pi-coding-agent from a global install if not local.
import { createRequire } from "node:module";
import { execFileSync } from "node:child_process";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { homedir } from "node:os";
import { pathToFileURL } from "node:url";

const PKG = "@earendil-works/pi-coding-agent";
const here = import.meta.url;
function resolvable() {
  try { createRequire(here).resolve(PKG); return true; } catch { return false; }
}
if (!resolvable()) {
  const cands = [];
  try { cands.push(join(execFileSync("npm", ["root", "-g"], { encoding: "utf8" }).trim(), PKG)); } catch {}
  cands.push(join(homedir(), ".pi/agent/npm/node_modules", PKG));
  const hit = cands.find((c) => existsSync(join(c, "package.json")));
  if (!hit) {
    console.error(`[pi-my-web] cannot find ${PKG}; install it (npm i -g ${PKG})`);
    process.exit(1);
  }
  // Re-exec with the package's node_modules parent on NODE_PATH is not honored by ESM,
  // so register a resolver hook.
  const mod = await import("node:module");
  const target = pathToFileURL(join(hit, "/")).href;
  const entry = new URL("dist/index.js", target).href;
  if (typeof mod.registerHooks === "function") {
    // Node >= 22.15 / 23.5: synchronous in-thread hooks (module.register is deprecated).
    mod.registerHooks({
      resolve(s, c, n) {
        return s === PKG ? { url: entry, shortCircuit: true } : n(s, c);
      },
    });
  } else {
    const hook = `export async function resolve(s,c,n){if(s===${JSON.stringify(PKG)})return{url:${JSON.stringify(entry)},shortCircuit:true};return n(s,c);}`;
    mod.register("data:text/javascript," + encodeURIComponent(hook));
  }
}
await import("../server/cli.js");
